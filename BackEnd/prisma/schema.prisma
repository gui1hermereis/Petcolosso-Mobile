generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id       Int     @id @default(autoincrement())
  username String?
  password String?
  email    String  @unique
  isAdm    Boolean @default(false)

  carrinho Carrinho[]

  @@map("users")
}

model Produto {
  id        Int     @id @default(autoincrement())
  descricao String?
  valor     Decimal?

  carrinho Carrinho[]

  @@map("produtos")
}

model Carrinho {
  id         Int      @id @default(autoincrement())
  idProd     Int
  idUser     Int
  quantidade Int

  produto Produto @relation(fields: [idProd], references: [id])
  usuario Usuario @relation(fields: [idUser], references: [id])

  @@map("carrinho")
}